# ============================================
# Achadinhos — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha:
#   cp .env.example .env

# ---- PostgreSQL ----
DATABASE_URL=postgresql+asyncpg://root:password@localhost:5432/achadinhos

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Telegram Bot ----
# Crie seu bot via @BotFather no Telegram e cole o token aqui
TELEGRAM_BOT_TOKEN=SEU_TOKEN_AQUI
# ID do canal (ex: @seucanaldeofertas ou -1001234567890)
TELEGRAM_CHANNEL_ID=@seucanaldeofertas

# ---- Instagram Graph API (V2) ----
# META_APP_ID=
# META_APP_SECRET=
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=

# ---- Twitter/X ----
# ATENÇÃO: NÃO usa a API oficial — automação via navegador (Playwright)
# simulando login normal. Viola os Termos de Uso do X e pode banir a conta.
# Veja README.md "Twitter/X" antes de habilitar. Se a conta tiver 2FA
# ativado, desative — o login automático não sabe responder ao código.
TWITTER_ENABLED=false
# TWITTER_USERNAME=
# TWITTER_PASSWORD=

# ---- Mercado Livre ----
# Opcional — a API pública funciona sem auth para volume baixo
# ML_CLIENT_ID=
# ML_CLIENT_SECRET=

# ---- Amazon PA-API (V2) ----
# AMAZON_ACCESS_KEY=
# AMAZON_SECRET_KEY=
# AMAZON_PARTNER_TAG=

# ---- Geral ----
ENVIRONMENT=development
LOG_LEVEL=INFO
