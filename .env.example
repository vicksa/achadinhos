# ============================================
# Achadinhos — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha:
#   cp .env.example .env

# URL pública da API usada nos links rastreáveis /go/{id}
# Em produção, use seu domínio HTTPS, ex: https://achadinhos.seudominio.com
PUBLIC_BASE_URL=http://localhost:8000

# ---- PostgreSQL ----
DATABASE_URL=postgresql+asyncpg://root:password@localhost:5432/achadinhos

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Telegram Bot ----
TELEGRAM_BOT_TOKEN=SEU_TOKEN_AQUI
TELEGRAM_CHANNEL_ID=@seucanaldeofertas

# ---- Monetização ----
# True = Shopee/Magalu/Temu só são publicados se houver affiliate_url.
AFFILIATE_REQUIRE_MONETIZABLE=true
# Link e código emitidos pelo portal oficial de afiliados Temu.
TEMU_AFFILIATE_URL=
TEMU_AFFILIATE_CODE=
# URL pública da sua loja Influenciador Magalu.
MAGALU_AFFILIATE_URL=

# ---- Instagram Graph API (V2) ----
# META_APP_ID=
# META_APP_SECRET=
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=

# ---- Twitter/X ----
TWITTER_ENABLED=false
# TWITTER_USERNAME=
# TWITTER_PASSWORD=

# ---- Mercado Livre ----
# ML_CLIENT_ID=
# ML_CLIENT_SECRET=

# ---- Amazon PA-API (V2) ----
# AMAZON_ACCESS_KEY=
# AMAZON_SECRET_KEY=
# AMAZON_PARTNER_TAG=

# ---- Geral ----
ENVIRONMENT=development
LOG_LEVEL=INFO
# LOG_FORMAT=texto
